# SQLite file used by Prisma.
DATABASE_URL="file:./dev.db"

# Admin panel credentials. Never commit the real values — set them here locally
# and as repository secrets / hosting environment variables in production.
ADMIN_USER="change-me"
ADMIN_PASSWORD="change-me"

# Session token stored in the admin cookie. Any long random string will do.
ADMIN_SECRET="change-me"
