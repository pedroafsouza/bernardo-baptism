# SQLite file used by Prisma.
DATABASE_URL="file:./dev.db"

# Admin accounts are stored in the database, not here.
#
# A fresh database bootstraps a single administrator:
#
#   username: admin
#   password: admin
#
# That account can do nothing at all until it sets a strong password on first
# login, and from then on administrators are added and removed inside the panel
# (Access menu). There is no credential in the environment to leak.
