# SQLite file used by Prisma.
DATABASE_URL="file:./dev.db"

# Public origin, used to build absolute links in the preview cards.
# NEXT_PUBLIC_SITE_URL="https://example.com"

# ---------------------------------------------------------------- The event
#
# The invitation itself — the child, the parents, the hours and the addresses.
# None of it is committed: production values are injected by the deployment
# pipeline (a single `EVENT_ENV` secret, see README → Configuration), and the
# variables below are what a local checkout would set by hand.
#
# Anything left unset falls back to the fictional christening in
# `lib/eventDetails.ts` — which is also what the public `/?code=DEMO` link
# always shows, no matter what is configured here.
#
# The invitation is rendered in the browser, so every variable is NEXT_PUBLIC_
# and is baked into the client bundle at build time. Put nothing in them that
# the guests are not meant to read.

# NEXT_PUBLIC_EVENT_CHILD="Bernardo Eksempel"
# NEXT_PUBLIC_EVENT_BIRTHDAY="01.01.2026"
# NEXT_PUBLIC_EVENT_MOTHER="Anna Eksempel"
# NEXT_PUBLIC_EVENT_FATHER="Jonas Eksempel"
# The surname the parents share, so an invitation is signed with it once.
# NEXT_PUBLIC_EVENT_FAMILY_NAME="Eksempel"

# NEXT_PUBLIC_EVENT_CEREMONY_TIME_DA="Lørdag den 1. august 2026 kl. 11:00"
# NEXT_PUBLIC_EVENT_CEREMONY_TIME_EN="Saturday 1 August 2026 at 11:00"
# NEXT_PUBLIC_EVENT_CEREMONY_TIME_PT="Sábado, 1 de agosto de 2026, às 11:00"
# NEXT_PUBLIC_EVENT_CEREMONY_PLACE="Eksempel Kirke, Eventyrvej 1, 1234 Eksempelby"

# NEXT_PUBLIC_EVENT_RECEPTION_TIME_DA="Efterfølgende"
# NEXT_PUBLIC_EVENT_RECEPTION_TIME_EN="Straight after the ceremony"
# NEXT_PUBLIC_EVENT_RECEPTION_TIME_PT="Logo após a cerimônia"
# NEXT_PUBLIC_EVENT_RECEPTION_PLACE="Eksempel Forsamlingshus, Eventyrvej 7, 1234 Eksempelby"

# The kitchen and the seating are ordered from the replies.
# NEXT_PUBLIC_EVENT_RSVP_DEADLINE_DA="1. juli 2026"
# NEXT_PUBLIC_EVENT_RSVP_DEADLINE_EN="1 July 2026"
# NEXT_PUBLIC_EVENT_RSVP_DEADLINE_PT="1 de julho de 2026"

# A wish list, never an expectation.
# NEXT_PUBLIC_EVENT_GIFT_LIST="https://example.com/wishlist"

# --------------------------------------------------------------- Admin login
#
# Admin accounts are stored in the database, not here.
#
# A fresh database bootstraps a single administrator:
#
#   username: admin
#   password: admin
#
# That account can do nothing at all until it sets a strong password on first
# login, and from then on administrators are added and removed inside the panel
# (Access menu). There is no credential in the environment to leak.
