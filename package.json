{
  "name": "bernardo-baptism",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:backfill": "tsx --env-file-if-exists=.env prisma/backfill.ts",
    "db:verify": "tsx --env-file-if-exists=.env prisma/verify.ts",
    "db:split": "tsx --env-file-if-exists=.env prisma/splitHouseholds.ts",
    "test": "tsx --test tests/*.test.ts",
    "db:push": "prisma db push"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.6",
    "phaser": "^3.87.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
