generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A person who can log into the admin panel. Credentials live in the database
/// (salted scrypt hashes), never in the environment, so passwords can be
/// rotated and admins added or removed without a redeploy.
model AdminUser {
  id                 String    @id @default(uuid())
  username           String    @unique
  passwordHash       String
  /// Bootstrap and admin-created accounts start with a throwaway password and
  /// cannot do anything until they have chosen a strong one.
  mustChangePassword Boolean   @default(true)
  failedAttempts     Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  createdByName      String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions AdminSession[]
}

/// One logged-in browser. Only the SHA-256 of the cookie token is stored, so a
/// database leak cannot be replayed as a live session.
model AdminSession {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([adminId])
  @@index([expiresAt])
}

/// Append-only trail of everything that matters: logins, invitations, guest
/// edits, admin changes and blocked requests.
model AuditLog {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  action     String
  actorName  String   @default("anonymous")
  actorId    String?
  targetType String?
  targetId   String?
  detail     String?
  ip         String?
  userAgent  String?
  success    Boolean  @default(true)

  @@index([createdAt])
  @@index([action])
}

model Guest {
  id            String    @id @default(uuid())
  guestCode     String    @unique
  name          String
  group         String
  status        String    @default("PENDING")
  /// How many adults and children this household is invited to bring. The RSVP
  /// form never offers more than this, and `maxKids = 0` means the invitation
  /// simply has no room for children — the picker is not shown at all.
  maxGuests     Int       @default(1)
  maxKids       Int       @default(0)
  /// What the household actually confirmed for the reception — the numbers the
  /// caterer works from, which is why they keep the plain names the head count,
  /// the admin table and the CSV already read. Always within the maximums
  /// above, and derived from the individual answers in `attendees`, so they
  /// always agree with who actually said yes.
  guestCount    Int       @default(1)
  kids          Int       @default(0)
  /// The same two numbers for the church. The day is two invitations in one:
  /// somebody can come to the ceremony and not to the party, or the other way
  /// round, so each part is counted on its own.
  churchCount   Int       @default(0)
  churchKids    Int       @default(0)
  /// Allergies and dietary needs for the children in the party. Children are
  /// counted, not named, so one shared note covers them all.
  kidsAllergies String    @default("")
  likely        Boolean   @default(true)
  inviteSent    Boolean   @default(false)
  inviteSentAt  DateTime?
  bones         Int       @default(0)
  blessings     Int       @default(0)
  score         Int       @default(0)
  /// Every distinct daily bone this household has ever picked up. Unlike
  /// `bones`, which is the best single run, this only ever grows — it is the
  /// standing of the day-by-day bone competition.
  bonesTotal    Int       @default(0)
  playedAt      DateTime?
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())

  attendees Attendee[]
}

/// One named adult on an invitation.
///
/// A `Guest` row is a household as it is addressed — "Marie and Kevin" on one
/// line — but the reply is given person by person: Marie can come while Kevin
/// cannot, and each of them has their own allergies. The people are derived
/// from the household line itself (see `lib/attendees.ts`), so an invitation
/// never grows extra seats; this table only records what each of them answered.
model Attendee {
  id        String   @id @default(uuid())
  guestCode String
  guest     Guest    @relation(fields: [guestCode], references: [guestCode], onDelete: Cascade)
  /// Position in the household line — the stable identity of a person, so an
  /// answer survives a re-render and follows the name it was given for.
  position  Int
  name      String
  /// One answer per part of the day, each `PENDING` until it is given and then
  /// `ATTENDING`/`DECLINED`. They are asked separately because they are
  /// separate invitations: the ceremony and the party afterwards.
  church    String   @default("PENDING")
  reception String   @default("PENDING")
  /// Free text, empty when there is nothing to declare.
  allergies String   @default("")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([guestCode, position])
  @@index([guestCode])
}

/// One bone, on one day, picked up by one household.
///
/// Bones are laid out afresh every morning (see `lib/dailyBones.ts`), and their
/// position in that day's list is their identity. Storing the individual
/// pickups rather than a counter is what makes the competition honest: the
/// unique key means the same bone can never be handed in twice, however many
/// times the batch is retried or the page reloaded.
model BoneCollection {
  id          String   @id @default(uuid())
  guestCode   String
  /// `YYYY-MM-DD` in Europe/Copenhagen — the day the bones belonged to.
  day         String
  /// Index into that day's generated bone list.
  boneIndex   Int
  collectedAt DateTime @default(now())

  @@unique([guestCode, day, boneIndex])
  @@index([guestCode])
  @@index([day])
}
